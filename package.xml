<?xml version="1.0"?>
<package format="3">
  <name>iso21423_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 to ISO 21423 connector: makes a Nav2 robot an ISO 21423 IMR.</description>
  <maintainer email="dev@openrobops.org">OpenRobOps</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
